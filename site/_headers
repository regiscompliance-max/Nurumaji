# Security headers apply to every response. HTML keeps the Workers default
# Cache-Control (public, max-age=0, must-revalidate) so pages revalidate.
# script-src hashes are the JSON-LD blocks. Regenerate them if that JSON changes.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-/s9KPFLCN1PUtE88byZlY3hM1gILfcoEdUwtSlI4RYQ=' 'sha256-2eXqAq5BYDZCkSi9n3K6xw57laazXPpQJLTCh3NqWqc=' 'sha256-s+k1psQVlOA6VnvL0Z1e0ArVd7zHV3o1sEijhjo2Pj4=' 'sha256-BPYmQ4BzzilvC1SJXcG2SBtIfocmo29XQSUn4Xq5xCY=' 'sha256-lY3go2jRxUYDf08tQ8SNcEstIvD2Tkdwaa4OQ2QY3uc=' 'sha256-FUHLfjiWTMdUeA7BBcO1cbjAGUDAOMVWCfyL/cj0yKM=' 'sha256-7IwUdgevKInVEB0AKC+hGZXxVwQLY/Jc710ci0y3bec='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; upgrade-insecure-requests

# Photos, icons and self-hosted fonts change with the file, but names are not hashed.
/assets/*
  Cache-Control: public, max-age=2592000

/assets/fonts/*
  Cache-Control: public, max-age=2592000

# CSS and JS are edited in place. Detach first: /assets/* also matches these
# files, and Cloudflare joins a repeated Cache-Control instead of replacing it.
/assets/styles.css
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/site.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/join.css
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/join.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/book.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/portal.css
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/portal.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The rest of the site keeps geolocation off. /join needs it for "Use my location".
/join
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400
