# Security headers apply to every response. HTML keeps the Workers default
# Cache-Control (public, max-age=0, must-revalidate) so pages revalidate.
# script-src hashes are the JSON-LD blocks. Regenerate them if that JSON changes.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-ZtIpncAL363VNmZmZq4vxD2j1VdjJXTYKOzmXlFnjTw=' 'sha256-jvEawfOB94Ol/WCa3tNL3DKffZHPUeGtTnAlqSNfb74=' 'sha256-KRFYZWiDtyjyzDYRckDgV1KFEC37DE0EDewgPOKt2GA=' 'sha256-bfGGG8K6wrlvZxUojkhRjVaE+h2+3pzRgjOLz6ypQR0=' 'sha256-lY3go2jRxUYDf08tQ8SNcEstIvD2Tkdwaa4OQ2QY3uc=' 'sha256-MHhxiWO3CG1pEoVVronAJ77YENLOEbEqavF9CFyPafc=' 'sha256-8KFM4+tuZOzL+gh+8CkUIKQtOLmr8qFuVUmL3ZBj0VU='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; upgrade-insecure-requests

# Photos, icons and self-hosted fonts change with the file, but names are not hashed.
/assets/*
  Cache-Control: public, max-age=2592000

/assets/fonts/*
  Cache-Control: public, max-age=2592000

# CSS and JS are edited in place. Detach first: /assets/* also matches these
# files, and Cloudflare joins a repeated Cache-Control instead of replacing it.
/assets/styles.css
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/site.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400
