# Security headers apply to every response. HTML keeps the Workers default
# Cache-Control (public, max-age=0, must-revalidate) so pages revalidate.
# script-src hashes are the JSON-LD blocks. Regenerate them if that JSON changes.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-xf7v39RJ0XNxr1GFo1qXOO4IsoKBrBXrrActi+872l4=' 'sha256-BUi9Ac6rrN7dwxYBeK/TSvjM2ZNm5VfZbFaFU8Q58hI=' 'sha256-hYYIvQ7ILo0fAReIaqS9s/4BhPB01W2etGo7hAf/kNU=' 'sha256-vScOFEbfYcHXOzxNKjQl3XwoJ9x7gZm2a5kce71QFWo=' 'sha256-lY3go2jRxUYDf08tQ8SNcEstIvD2Tkdwaa4OQ2QY3uc=' 'sha256-zJOrokCZb/HQZ94tRsTnxbx0aLqLdMztLkDP1fMrZok=' 'sha256-S1cw1FfyHtc0aavAq4KdKuwsXqgmHOiOOepVcEQCu2s='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; upgrade-insecure-requests

# Photos, icons and self-hosted fonts change with the file, but names are not hashed.
/assets/*
  Cache-Control: public, max-age=2592000

/assets/fonts/*
  Cache-Control: public, max-age=2592000

# CSS and JS are edited in place, so return visitors should pick up fixes within a day.
/assets/styles.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/site.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400
